{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Packer 창이 쓰는 권한: 파일/폴더 선택 다이얼로그, 탐색기에서 열기, 클립보드 쓰기.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "clipboard-manager:allow-write-text"
  ]
}
